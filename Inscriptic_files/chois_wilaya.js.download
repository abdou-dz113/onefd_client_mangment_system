 function valpha(myfield, e, dec) {
                var key;
                var keychar;
                if (window.event)
                    key = window.event.keyCode;
                else if (e)
                    key = e.which;
                else
                    return true;
                keychar = String.fromCharCode(key);
                if ((key == null) || (key == 0) || (key == 8) || (key == 9) || (key == 13)
                        || (key == 27))
                    return true;
                else if ((("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz")
                        .indexOf(keychar) > -1))
                    return true;
                else if (dec && (keychar == " ") && (myfield.value.length != 0)) {
                    myfield.form.elements[dec].focus();
                    return false;
                } else
                    return false;
            }
//================================================================================
function valphaNumSpec(input, event) {
    var key = event.which || event.keyCode;
    var char = String.fromCharCode(key);

    // Autoriser les touches spéciales : backspace, delete, tab, flèches
    if (key === 8 || key === 9 || key === 46 || (key >= 37 && key <= 40)) {
        return true;
    }

    // Expression régulière : lettres, chiffres et caractères spéciaux courants
    var regex =/^[A-Za-z0-9!@#$%&*()\-\+=_\[\]{};:,.<>?]+$/;

    return regex.test(char);
}
//================================================================================
function valphaNumDash(input, event) {

    const key = event.key;

    // Autoriser les touches de contrôle (effacement, déplacement, tabulation)
    const controlKeys = [
        'Backspace', 'Tab', 'Delete', 
        'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'
    ];

    if (controlKeys.includes(key)) {
        return true;
    }

    // Autoriser uniquement A-Z, a-z, -, _
    const allowed = /^[a-zA-Z0-9\-_]$/;

    if (key.length === 1 && !allowed.test(key)) {
        event.preventDefault();
        return false;
    }

    return true;
}

