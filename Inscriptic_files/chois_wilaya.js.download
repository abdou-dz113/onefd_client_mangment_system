//===================================================  
    function presumer()
    {

        var vv = document.getElementById('pre').checked;
        if (vv)
        {
            document.getElementById('jour').disabled = true;
            document.getElementById('jour').selectedIndex = '0';

            document.getElementById('mois').disabled = true;
            document.getElementById('mois').selectedIndex = '0';
        }
        else if (vv == false)
        {
            document.getElementById('jour').disabled = false;
            document.getElementById('mois').disabled = false;
        }
    }
function zz(){
        var val = document.getElementById('check').checked;
        if (val)
        {
            document.getElementById('download_pdf').disabled = false;
            document.getElementById('downl_pdf').disabled = false;
    }else if (val == false)
       {
           document.getElementById('download_pdf').disabled = true;
           document.getElementById('downl_pdf').disabled = true;
        }
}
//==========================================================================
   
            function vara(myfield, e, dec) {
                var key;
                var keychar;
                if (window.event)
                    key = window.event.keyCode;
                else if (e)
                    key = e.which;
                else
                    return true;
                keychar = String.fromCharCode(key);
                if ((key == null) || (key == 0) || (key == 8) || (key == 9) || (key == 13)
                        || (key == 27))
                    return true;
                else if ((("ابتثج حخدؤآذرزسشصضطظعغفقكلمنهويأإءئةى").indexOf(keychar) > -1))
                    return true;
                else if (dec && (keychar == " ") && (myfield.value.length != 0)) {
                    myfield.form.elements[dec].focus();
                    return false;
                } else
                    return false;
            }
